# NOTE: .git is deliberately NOT ignored — webpack derives the asset directory name (and therefore
# the cache-busting key) from `git rev-parse HEAD`. If you do exclude it, pass the hash explicitly:
#     docker build --build-arg COMMIT_HASH=$(git rev-parse HEAD) .

