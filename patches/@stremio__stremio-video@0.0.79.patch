new file mode 100644
index 0000000000000000000000000000000000000000..bfbbb0cb94bd7c3ac3897355dc6c14df54eb01df
--- /dev/null
+++ b/src/nativeHlsOnly.js
@@ -0,0 +1,38 @@
+var result = null;
+
+// True only for browsers that have no full MediaSource but do own a native HLS stack in the
+// <video> element — in practice iPhone Safari and the iOS WebViews built on it.
+//
+// Deliberately NOT `!Hls.isSupported()`. hls.js >= 1.5 treats ManagedMediaSource as usable and in
+// fact prefers it — getMediaSource() defaults preferManagedMediaSource to true and returns
+// `(preferManagedMediaSource || !self.MediaSource) && self.ManagedMediaSource` before ever looking
+// at self.MediaSource — so on iOS 17.1+ `Hls.isSupported()` returns true and a gate built on it
+// never fires on the very devices it was meant to catch.
+//
+// ManagedMediaSource-only means "no real MSE". There we prefer the platform's own HLS stack over
+// driving hls.js through MMS: it is the more battery-friendly path, and MMS playback would still
+// be fed the unusable URLs this gate exists to correct.
+//
+// WebKitMediaSource counts as a full MediaSource — ancient Safari builds exposing only that still
+// run hls.js, which falls back to it. ManagedMediaSource explicitly does not count.
+//
+// Every desktop browser — Chrome, Vivaldi, Edge, Firefox, macOS Safari — and desktop-class iPadOS
+// Safari expose window.MediaSource, so the gate is false there and every code path guarded by it
+// keeps its stock behaviour.
+function nativeHlsOnly() {
+    if (result === null) {
+        if (typeof window === 'undefined' || typeof document === 'undefined') {
+            result = false;
+        } else if (window.MediaSource || window.WebKitMediaSource) {
+            result = false;
+        } else {
+            var probeElement = document.createElement('video');
+            result = typeof probeElement.canPlayType === 'function' &&
+                probeElement.canPlayType('application/vnd.apple.mpegurl') !== '';
+        }
+    }
+
+    return result;
+}
+
+module.exports = nativeHlsOnly;
