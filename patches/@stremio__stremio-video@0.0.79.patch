diff --git a/src/nativeHlsOnly.js b/src/nativeHlsOnly.js
new file mode 100644
index 0000000000000000000000000000000000000000..df44c274dbfb0792fd034a369d9c5396dc683b32
--- /dev/null
+++ b/src/nativeHlsOnly.js
@@ -0,0 +1,25 @@
+var Hls = require('hls.js');
+
+var result = null;
+
+// True only for browsers that cannot run hls.js at all but do own a native HLS stack in the
+// <video> element — in practice iOS/iPadOS Safari and the WebKit views built on it, where
+// MediaSource does not exist (only ManagedMediaSource, which hls.js 1.5 does not use).
+//
+// Everything gated on this is off wherever hls.js works, which is every desktop browser, so the
+// stock code paths are left untouched there.
+function nativeHlsOnly() {
+    if (result === null) {
+        if (typeof document === 'undefined' || Hls.isSupported()) {
+            result = false;
+        } else {
+            var probeElement = document.createElement('video');
+            result = typeof probeElement.canPlayType === 'function' &&
+                probeElement.canPlayType('application/vnd.apple.mpegurl') !== '';
+        }
+    }
+
+    return result;
+}
+
+module.exports = nativeHlsOnly;
