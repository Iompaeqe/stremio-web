+    var localPath = '/' + infoHash.toLowerCase() + '/' + fileIdx;
+    if (parsedMediaURL.pathname.toLowerCase().slice(-localPath.length) !== localPath) {
+        return mediaURL;
+    }
+
+    return SERVER_LOCAL_ORIGIN + localPath;
+}
