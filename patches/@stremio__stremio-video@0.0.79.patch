+    if (typeof infoHash !== 'string' || infoHash.length === 0 || fileIdx === null || fileIdx === undefined || !isFinite(fileIdx)) {
+        return mediaURL;
+    }
+
+    var parsedMediaURL;
+    var parsedServerURL;
+    try {
+        parsedMediaURL = new URL(mediaURL);
+        parsedServerURL = new URL(streamingServerURL);
+    } catch (error) {
+        return mediaURL;
+    }
