+// ---------------------------------------------------------------------------------------------
+// Native-HLS transcoding path (iOS Safari).
+//
+// A browser without MediaSource cannot run hls.js, so the /hlsv2/ playlist has to be handed to the
+// <video> element as a plain src and decoded by the platform's own HLS stack. Two things get in the
+// way of that when the streaming server is reached through a reverse proxy, and both are corrected
+// below — but only while `nativeHlsOnly()` is true, so every browser that can run hls.js keeps the
+// stock behaviour untouched.
+//
+//   1. `url.resolve(base, '/hlsv2/...')` replaces the base path instead of extending it, so a
+//      streaming server mounted on a subpath (https://host/stremio-server/) loses that prefix and
+//      the request never reaches the server at all. `joinServerURL` joins rather than replaces; for
+//      a server URL whose path is already "/" it produces the exact same string as `url.resolve`.
+//
+//   2. `mediaURL` is fetched by the *streaming server*, not by the browser. Handing it the public
+//      URL sends the server back out through its own reverse proxy, where an access-control layer
+//      answers with a login redirect and the transcode fails with HTTP 500. Anything the server
+//      serves itself (a torrent addressed by infoHash/fileIdx) is always reachable on its own
+//      loopback origin, so point it there instead. The URL the *browser* uses is never rewritten.
+// ---------------------------------------------------------------------------------------------
+
+// The port the streaming server always listens on; its own loopback view of itself.
+var SERVER_LOCAL_ORIGIN = 'http://127.0.0.1:11470';
+
+function joinServerURL(streamingServerURL, path) {
+    var base = streamingServerURL.charAt(streamingServerURL.length - 1) === '/' ?
+        streamingServerURL
+        :
+        streamingServerURL + '/';
+    return new URL(path.replace(/^\/+/, ''), base).href;
+}
+
+function resolveServerURL(streamingServerURL, path) {
+    return nativeHlsOnly() ?
+        joinServerURL(streamingServerURL, path)
+        :
+        url.resolve(streamingServerURL, path);
+}
