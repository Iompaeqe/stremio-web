diff --git a/src/withStreamingServer/serverURL.js b/src/withStreamingServer/serverURL.js
new file mode 100644
index 0000000000000000000000000000000000000000..6dfd539ad299a84e75888f4a4f02f05c9a5bd6db
--- /dev/null
+++ b/src/withStreamingServer/serverURL.js
@@ -0,0 +1,33 @@
+var url = require('url');
+
+// Every URL that addresses the streaming server is built here. One primitive, so a call site
+// cannot be forgotten again — the previous fix corrected three of them and left five behind.
+//
+// The stock code calls `url.resolve(streamingServerURL, '/whatever')`, and url.resolve REPLACES
+// the base path with the absolute one it is given. With a streaming server mounted on a subpath —
+// https://host/stremio-server/ — '/hlsv2/…' resolves to https://host/hlsv2/…, which is not the
+// streaming server at all: the request lands on whatever else that origin serves (for us, the hub
+// answering 404 text/html) and the player reports a broken stream rather than a bad URL.
+//
+// So: join instead of replace. For a streaming server whose path is already "/" — every desktop
+// install, http://127.0.0.1:11470/ — joining produces byte-for-byte the string url.resolve
+// produced, so nothing that worked before changes. url.resolve remains the fallback for input
+// the URL constructor refuses, which keeps even a malformed server URL behaving as it used to.
+function serverURL(streamingServerURL, path) {
+    if (typeof streamingServerURL !== 'string' || streamingServerURL.length === 0) {
+        return url.resolve(streamingServerURL, path);
+    }
+
+    var base = streamingServerURL.charAt(streamingServerURL.length - 1) === '/' ?
+        streamingServerURL
+        :
+        streamingServerURL + '/';
+
+    try {
+        return new URL(String(path).replace(/^\/+/, ''), base).href;
+    } catch (error) {
+        return url.resolve(streamingServerURL, path);
+    }
+}
+
+module.exports = serverURL;
